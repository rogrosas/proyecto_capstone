{
  "name": "easyoffice-web",
  "version": "0.3.0",
  "private": true,
  "description": "Front end de Easy Office en HTML, CSS y JavaScript, servido con Node.js (Express) y conectado a PostgreSQL.",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "db:revisar": "node --env-file-if-exists=.env scripts/revisar-bd.js",
    "crear-usuario": "node --env-file-if-exists=.env scripts/crear-usuario.js",
    "db:diccionario": "node scripts/diccionario/generar.js \"../base de datos/easyoffice_v2.sql\" \"../base de datos/diccionario_datos_easyoffice.html\"",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=2 \"tests/**/*.test.js\"",
    "test:unidad": "node --test \"tests/unidad/**/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^4.21.2",
    "mammoth": "^1.11.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "pizzip": "^3.1.7"
  }
}
