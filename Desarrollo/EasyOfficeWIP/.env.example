# Copie este archivo como .env y complete la contraseña.
# .env está en .gitignore: nunca se sube al repositorio.

# Conexión a PostgreSQL (los mismos datos con que entra en pgAdmin 4)
PGHOST=localhost
PGPORT=5432
PGDATABASE=EO_ER
PGUSER=postgres
PGPASSWORD=

# Puerto del sitio
PORT=3000

# Portal de clientes (/mi-cuenta): acceso por enlace enviado al correo
# Dirección pública del sitio, para armar el enlace del correo
APP_URL=http://localhost:3000
# Clave para firmar los enlaces (texto largo y aleatorio). Si falta, se genera al iniciar
# y los enlaces enviados dejan de servir cuando se reinicia el servidor.
CLIENTE_SECRETO=

# Correo saliente (SMTP). Si SMTP_HOST queda vacío, los correos se guardan en correos-dev/
# y el enlace se muestra en la consola del servidor (modo desarrollo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CORREO_REMITENTE=Easy Office <no-responder@easyoffice.cl>

# Carpeta de plantillas y contratos Word (relativa a esta carpeta del proyecto o absoluta).
# En la base de datos solo se guarda la ruta dentro de ella.
CONTRATOS_DIR=../base de datos/Contratos
